APP_NAME=CloudStack BlueField Integration API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8081
LOG_LEVEL=INFO

# mock: development on zona-01
# cli: container deployment on BlueField
ESWITCH_ADAPTER_MODE=mock

ESWITCHCTL_PATH=/usr/local/bin/eswitchctl
ESWITCHCTL_TIMEOUT_SECONDS=10
ESWITCH_CONTROL_SOCKET=/run/eswitch-management/control.sock

# Replace only in the real .env file.
# Never commit the real token.
API_TOKEN=replace-with-a-secure-token
