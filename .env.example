APP_NAME=CloudStack BlueField Integration API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8081
LOG_LEVEL=INFO

# mock or unix_socket
ESWITCH_ADAPTER_MODE=mock

# Available only on the BlueField machine
ESWITCH_CONTROL_SOCKET=/run/eswitch-management/control.sock

# Do not put real secrets in this file
API_TOKEN=replace-with-secret
